# Cloud Run injects PORT automatically (defaults to 8080)
PORT=8080

# Optional: Configure a Google Cloud Storage bucket for persistent object storage.
# When omitted, ClearCut Cloud automatically falls back to ephemeral in-memory object URLs
# so the app runs error-free both locally and on Cloud Run without crashing.
GCS_BUCKET_NAME=

# Optional: Custom public base URL for GCS objects (defaults to https://storage.googleapis.com/<GCS_BUCKET_NAME>)
GCS_PUBLIC_BASE_URL=

# Optional: SQLite metadata database path (stores ONLY lightweight metadata; 0 BLOBs)
DB_PATH=./data/clearcut_metadata.db
